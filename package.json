{
  "name": "amazon-ai-operations-os",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @amazon-ai-os/web",
    "dev:api": "python -m uvicorn --app-dir apps/api/src amazon_ai_api.main:app --reload --host 127.0.0.1 --port 8000",
    "build": "npm run build --workspace @amazon-ai-os/web",
    "test": "npm run test --workspace @amazon-ai-os/web",
    "test:api": "python -m pytest apps/api/tests",
    "test:infra": "python -m unittest discover -s infra/tests -v",
    "test:all": "npm run test && npm run test:api && npm run test:infra",
    "seed:synthetic": "python scripts/seed_synthetic.py --output-dir synthetic-output"
  },
  "engines": {
    "node": ">=22"
  }
}
